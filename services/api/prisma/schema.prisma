generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Клиент (Бизнес)
model Tenant {
  id              String    @id @default(uuid())
  name            String
  subscriptionEnd DateTime? 
  isActive        Boolean   @default(true)
  
  users           User[]
  screens         Screen[]
  contents        Content[]
}

// 2. Роли
enum UserRole {
  ADMIN
  SMM
  DESIGNER
}

// 3. Сотрудник клиента
model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  role         UserRole  @default(ADMIN)
  otpCode      String?
  otpExpiresAt DateTime?
  
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade) // <-- ДОБАВЛЕНО
}

// 4. Экран (Приставка)
model Screen {
  id         String   @id @default(uuid())
  name       String
  deviceId   String   @unique
  isActive   Boolean  @default(true)
  
  contentIds String[] @default([])
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade) // <-- ДОБАВЛЕНО
}

// 5. Видео
model Content {
  id              String      @id @default(uuid())
  type            ContentType
  url             String
  durationSec     Int
  hasAudio        Boolean     @default(false)
  orientation     Orientation @default(HORIZONTAL)
  maxPerHour      Int?
  cooldownMin     Int?
  requiresConsent Boolean     @default(false)
  dayparts        String[]
  createdAt       DateTime    @default(now())
  actionUrl       String?     // Ссылка для QR-кода
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade) // <-- ДОБАВЛЕНО
}

enum Orientation {
  HORIZONTAL
  VERTICAL
}

enum ContentType {
  BASE       // Атмосфера (фон)
  ANCHOR     // Короткая заставка
  PROMO      // Универсальная реклама
  OFFER      // Спецпредложение (акция)
  SERVICE    // Услуга/Сотрудник
}

