generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Клиент (Бизнес)
model Tenant {
  id              String    @id @default(uuid())
  name            String
  subscriptionEnd DateTime? 
  isActive        Boolean   @default(true)
  
  users           User[]
  screens         Screen[]
  contents        Content[]
  videoWalls      VideoWall[] // <-- ДОБАВИЛИ СВЯЗЬ
}

// 2. Роли
enum UserRole {
  ADMIN
  SMM
  DESIGNER
}

// 3. Сотрудник клиента
model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  role         UserRole  @default(ADMIN)
  otpCode      String?
  otpExpiresAt DateTime?
  
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 4. Экран (Приставка)
model Screen {
  id         String   @id @default(uuid())
  name       String
  deviceId   String   @unique
  isActive   Boolean  @default(true)
  
  contentIds String[] @default([])
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // СВЯЗЬ С МЕДИАСТЕНОЙ
  wallId     String?
  wall       VideoWall? @relation(fields: [wallId], references: [id], onDelete: SetNull)
  wallRole   WallRole?
}

// 5. Видео
model Content {
  id              String      @id @default(uuid())
  type            ContentType
  url             String
  durationSec     Int
  hasAudio        Boolean     @default(false)
  orientation     Orientation @default(HORIZONTAL)
  maxPerHour      Int?
  cooldownMin     Int?
  requiresConsent Boolean     @default(false)
  dayparts        String[]
  createdAt       DateTime    @default(now())
  actionUrl       String?     
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum Orientation {
  HORIZONTAL
  VERTICAL
}

enum ContentType {
  BASE       // Атмосфера (фон)
  ANCHOR     // Короткая заставка
  PROMO      // Универсальная реклама
  OFFER      // Спецпредложение (акция)
  SERVICE    // Услуга/Сотрудник
}

// --- МОДЕЛИ ДЛЯ МЕДИАСТЕНЫ ---

enum WallRole {
  INFO
  VIDEO_FULL
  VIDEO_TOP
  VIDEO_BOTTOM
  VIDEO_LEFT
  VIDEO_RIGHT
}

enum WallLayout {
  TWO_HORIZONTAL
  TWO_VERTICAL
  THREE_HORIZONTAL
  THREE_VERTICAL
}

model VideoWall {
  id         String    @id @default(uuid())
  name       String
  layoutType WallLayout
  
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  screens    Screen[]
  items      VideoWallItem[]
  createdAt  DateTime  @default(now())
}

model VideoWallItem {
  id          String      @id @default(uuid())
  wallId      String
  wall        VideoWall   @relation(fields: [wallId], references: [id], onDelete: Cascade)
  
  tenantId    String      
  type        ContentType
  url         String
  durationSec Int
  orientation Orientation @default(HORIZONTAL)
  
  qrUrl       String?     
  infoText    String?     
  dayparts    String[]
  
  createdAt   DateTime    @default(now())
}